// Define the pin where the push button is connected
const int buttonPin = 2;

// Variables to hold button states
int buttonState;           // Current state of the button
int lastButtonState = LOW; // Previous state of the button

// Variables for debouncing
unsigned long lastDebounceTime = 0;  // Timestamp of last button state change
unsigned long debounceDelay = 50;    // Debounce delay time in milliseconds

// Counter to track number of button presses
int counter = 0;

void setup() {
  pinMode(buttonPin, INPUT);      // Set button pin as input
  Serial.begin(9600);             // Initialize Serial Monitor at 9600 bps
}

void loop() {
  // Read the state of the button
  int reading = digitalRead(buttonPin);

  // If the button state has changed, reset the debounce timer
  if (reading != lastButtonState) {
    lastDebounceTime = millis();
  }

  // Check if the state has been stable for the debounce delay
  if ((millis() - lastDebounceTime) > debounceDelay) {
    // If the button is pressed and was previously unpressed
    if (reading == HIGH && buttonState == LOW) {
      counter++;  // Increment counter
      Serial.print("Button Pressed: ");
      Serial.println(counter);  // Display the count on Serial Monitor
    }
    // Update the button state
    buttonState = reading;
  }

  // Save the current reading for next loop iteration
  lastButtonState = reading;
}
